.page {
  min-height: 100vh;
  background: var(--bn-bg);
}

.stage {
  max-width: 840rpx;
  margin: 0 auto;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* —— Symbol header —— */
.sym-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.sym-row__left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sym-row__name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--bn-text);
  line-height: 1.3;
}

.sym-row__code {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--bn-text-secondary);
  font-variant-numeric: tabular-nums;
}

.sym-row__status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 14rpx;
  background: var(--bn-surface);
  border: 1rpx solid var(--bn-border);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--bn-text-secondary);
  flex-shrink: 0;
}

.sym-row__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--bn-yellow);
}

.sym-row__dot--closed {
  background: var(--bn-text-tertiary);
}

/* —— Price hero (Binance left-aligned large) —— */
.price-block {
  margin-top: 28rpx;
}

.price-block__value {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
  color: var(--bn-text);
}

.price-block__value--up {
  color: var(--bn-up);
}

.price-block__value--down {
  color: var(--bn-down);
}

.price-block__value--flash {
  animation: flash-price 160ms ease-out;
}

.price-block__delta {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
}

.price-block__delta--up {
  color: var(--bn-up);
}

.price-block__delta--down {
  color: var(--bn-down);
}

.price-block__delta--flat {
  color: var(--bn-flat);
}

.price-block__sep {
  color: var(--bn-text-tertiary);
  font-weight: 400;
}

.price-block__meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--bn-text-tertiary);
  line-height: 1.4;
}

.price-block__warn {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--bn-yellow);
}

.price-block__mock {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--bn-text-tertiary);
}

/* —— Panels —— */
.panel {
  margin-top: 36rpx;
  padding: 24rpx 20rpx 20rpx;
  background: var(--bn-surface);
  border: 1rpx solid var(--bn-border);
  border-radius: 16rpx;
}

.panel--vix {
  margin-top: 24rpx;
}

.panel__tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.panel__tab {
  min-width: 64rpx;
  padding: 8rpx 16rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--bn-text-secondary);
  border-radius: 8rpx;
}

.panel__tab--active {
  color: var(--bn-yellow);
  background: rgba(240, 185, 11, 0.12);
}

.chart-fallback {
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bn-text-tertiary);
  font-size: 24rpx;
}

/* —— Action —— */
.action {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
}

.action__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-bottom: 10rpx;
}

.action__icon-ring {
  position: absolute;
  inset: 0;
  border: 3rpx solid var(--bn-text-secondary);
  border-right-color: transparent;
  border-radius: 50%;
}

.action__icon-arrow {
  position: absolute;
  top: -2rpx;
  right: 2rpx;
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-bottom: 10rpx solid var(--bn-text-secondary);
  transform: rotate(55deg);
}

.action text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--bn-text-secondary);
}

.action--disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* —— Error / loading —— */
.error-panel {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.error-panel__text {
  font-size: 30rpx;
  color: var(--bn-text-secondary);
  line-height: 1.5;
  max-width: 560rpx;
}

.skeleton {
  background: var(--bn-skeleton);
  border-radius: 8rpx;
}

.skeleton--sym {
  width: 280rpx;
  height: 36rpx;
}

.skeleton--pill {
  width: 120rpx;
  height: 40rpx;
}

.skeleton--price {
  margin-top: 32rpx;
  width: 360rpx;
  height: 80rpx;
}

.skeleton-row {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
}

.skeleton--chg {
  width: 140rpx;
  height: 32rpx;
}

.skeleton--chart {
  margin-top: 40rpx;
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
}

.skeleton--panel {
  margin-top: 24rpx;
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
}

.loading-hint {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--bn-text-tertiary);
  text-align: center;
  display: block;
}

.anim-in {
  animation: rise-in 260ms ease-out both;
}

.anim-in--delay1 {
  animation-delay: 40ms;
}

.anim-in--delay2 {
  animation-delay: 90ms;
}

.anim-in--delay3 {
  animation-delay: 140ms;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes flash-price {
  0% {
    opacity: 0.65;
  }
  100% {
    opacity: 1;
  }
}
