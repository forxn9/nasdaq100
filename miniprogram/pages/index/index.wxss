.page {
  min-height: 100vh;
  background: var(--bg);
}

.stage {
  max-width: 840rpx;
  margin: 0 auto;
  min-height: 100vh;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* —— Symbol（左对齐） —— */
.sym-block {
  display: flex;
  flex-direction: column;
}

.sym-block__name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.sym-block__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-muted);
  line-height: 1.3;
}

/* —— Price hero —— */
.price-block {
  margin-top: 32rpx;
}

.price-block__value {
  display: block;
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
  color: var(--ink);
}

.price-block__value--live {
  animation: breath 2.6s ease-in-out infinite;
}

.price-block__value--flash {
  animation: flash-price 150ms ease-out;
}

.price-block__delta {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
}

.price-block__delta--up {
  color: var(--up);
}

.price-block__delta--down {
  color: var(--down);
}

.price-block__delta--flat {
  color: var(--flat);
}

.price-block__sep {
  display: none;
}

.price-block__meta-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 10rpx;
  font-size: 24rpx;
  color: var(--ink-muted);
  line-height: 1.4;
}

.price-block__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--status-dot);
  flex-shrink: 0;
}

.price-block__dot--closed {
  background: var(--status-closed);
}

.price-block__meta-sep {
  color: var(--ink-subtle);
}

.price-block__tz {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-subtle);
  line-height: 1.4;
}

.price-block__warn {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--warning);
}

.price-block__mock {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-subtle);
}

.divider {
  margin: 28rpx 0;
  height: 1rpx;
  background: var(--divider);
}

/* —— Chart / VIX blocks（微抬表面，非白卡片） —— */
.chart-block,
.vix-block {
  padding: 8rpx 0 4rpx;
}

.chart-fallback {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 16rpx;
  color: var(--ink-subtle);
  font-size: 24rpx;
  background: var(--bg-elevated);
  border-radius: 4rpx;
  padding: 24rpx;
}

.chart-fallback__label {
  color: var(--ink-muted);
  font-weight: 500;
}

/* —— Action —— */
.action {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
}

.action__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-bottom: 10rpx;
}

.action__icon-ring {
  position: absolute;
  inset: 0;
  border: 3rpx solid var(--ink-muted);
  border-right-color: transparent;
  border-radius: 50%;
}

.action__icon-arrow {
  position: absolute;
  top: -2rpx;
  right: 2rpx;
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-bottom: 10rpx solid var(--ink-muted);
  transform: rotate(55deg);
}

.action text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.action--disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* —— Error / loading —— */
.error-panel {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.error-panel__text {
  font-size: 30rpx;
  color: var(--ink-muted);
  line-height: 1.5;
  max-width: 560rpx;
}

.skeleton {
  background: var(--skeleton);
  border-radius: 6rpx;
}

.skeleton--sym {
  width: 300rpx;
  height: 36rpx;
}

.skeleton--sub {
  margin-top: 12rpx;
  width: 260rpx;
  height: 24rpx;
}

.skeleton--price {
  margin-top: 32rpx;
  width: 360rpx;
  height: 80rpx;
}

.skeleton-row {
  margin-top: 20rpx;
  display: flex;
  gap: 32rpx;
}

.skeleton--chg {
  width: 140rpx;
  height: 30rpx;
}

.skeleton--chart {
  margin-top: 40rpx;
  width: 100%;
  height: 360rpx;
  border-radius: 4rpx;
}

.skeleton--vix {
  margin-top: 28rpx;
  width: 100%;
  height: 120rpx;
  border-radius: 4rpx;
}

.loading-hint {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--ink-subtle);
  text-align: center;
  display: block;
}

.anim-in {
  animation: rise-in 280ms ease-out both;
}

.anim-in--delay1 {
  animation-delay: 50ms;
}

.anim-in--delay2 {
  animation-delay: 100ms;
}

.anim-in--delay3 {
  animation-delay: 150ms;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes breath {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.97;
  }
}

@keyframes flash-price {
  0% {
    opacity: 0.7;
  }
  100% {
    opacity: 1;
  }
}

@media (max-width: 320px) {
  .price-block__value {
    font-size: 72rpx;
  }
}
