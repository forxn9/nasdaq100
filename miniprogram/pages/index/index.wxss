.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.atmosphere {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 45%, var(--bg-bottom) 100%);
  pointer-events: none;
}

.atmosphere__glow {
  position: absolute;
  top: 40rpx;
  right: -40rpx;
  width: 420rpx;
  height: 220rpx;
  background: rgba(255, 255, 255, 0.35);
  transform: rotate(-12deg);
  filter: blur(2rpx);
}

.atmosphere__ticks {
  position: absolute;
  inset: 0;
  opacity: 1;
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 46rpx,
    rgba(21, 32, 51, 0.05) 46rpx,
    rgba(21, 32, 51, 0.05) 48rpx
  );
}

.atmosphere__rail {
  position: absolute;
  top: 12%;
  bottom: 18%;
  width: 2rpx;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(21, 32, 51, 0.1) 20%,
    rgba(21, 32, 51, 0.1) 80%,
    transparent 100%
  );
}

.atmosphere__rail--left {
  left: 24rpx;
}

.atmosphere__rail--right {
  right: 24rpx;
}

.stage {
  position: relative;
  z-index: 1;
  max-width: 840rpx;
  margin: 0 auto;
  min-height: 100vh;
  padding: 80rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.brand__emblem {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand__crosshair {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.brand__crosshair-h,
.brand__crosshair-v {
  position: absolute;
  background: rgba(21, 32, 51, 0.45);
}

.brand__crosshair-h {
  left: 4rpx;
  right: 4rpx;
  top: 50%;
  height: 2rpx;
  margin-top: -1rpx;
}

.brand__crosshair-v {
  top: 4rpx;
  bottom: 4rpx;
  left: 50%;
  width: 2rpx;
  margin-left: -1rpx;
}

.brand__crosshair-ring {
  position: absolute;
  inset: 6rpx;
  border: 2rpx solid rgba(21, 32, 51, 0.35);
  border-radius: 50%;
}

.brand__title {
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.25;
  color: var(--ink);
  letter-spacing: 0;
}

.brand__subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.4;
  color: var(--ink-muted);
}

.hero {
  position: relative;
  width: 100%;
  margin-top: 72rpx;
  padding: 28rpx 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero__bezel {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero__corner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-color: rgba(21, 32, 51, 0.22);
  border-style: solid;
}

.hero__corner--tl {
  top: 0;
  left: 0;
  border-width: 2rpx 0 0 2rpx;
}

.hero__corner--tr {
  top: 0;
  right: 0;
  border-width: 2rpx 2rpx 0 0;
}

.hero__corner--bl {
  bottom: 0;
  left: 0;
  border-width: 0 0 2rpx 2rpx;
}

.hero__corner--br {
  bottom: 0;
  right: 0;
  border-width: 0 2rpx 2rpx 0;
}

.hero__price {
  font-size: 116rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
  color: var(--ink);
}

.hero__price--live {
  animation: breath 2.6s ease-in-out infinite;
}

.hero__price--flash {
  animation: flash 150ms ease-out;
}

.hero__delta {
  margin-top: 32rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 20rpx;
  font-size: 38rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
}

.hero__delta--up,
.hero__price--up.hero__price--flash {
  color: var(--up);
}

.hero__delta--up {
  color: var(--up);
}

.hero__delta--down {
  color: var(--down);
}

.hero__delta--flat {
  color: var(--flat);
}

.hero__sep {
  color: var(--ink-subtle);
  font-weight: 400;
  font-family: "PingFang SC", sans-serif;
}

.meta {
  width: 100%;
  margin-top: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.meta__warn {
  width: 100%;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--warning);
}

.meta__status {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  margin-bottom: 20rpx;
}

.meta__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--status-dot);
  flex-shrink: 0;
}

.meta__dot--closed {
  background: var(--status-closed);
}

.meta__status-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.4;
}

.meta__closed-hint {
  font-size: 24rpx;
  color: var(--ink-subtle);
  line-height: 1.4;
}

.meta__time {
  font-size: 26rpx;
  color: var(--ink-muted);
  line-height: 1.4;
}

.meta__tz {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-subtle);
  line-height: 1.4;
}

.meta__mock {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--ink-subtle);
  line-height: 1.4;
}

.action {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
}

/* §1.4：刷新圆形箭头图标（描边，无填充胶囊） */
.action__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-bottom: 10rpx;
}

.action__icon-ring {
  position: absolute;
  inset: 0;
  border: 3rpx solid var(--ink);
  border-right-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.action__icon-arrow {
  position: absolute;
  top: -2rpx;
  right: 2rpx;
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-bottom: 10rpx solid var(--ink);
  transform: rotate(55deg);
}

.action text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.4;
}

.action__line {
  margin-top: 8rpx;
  width: 120rpx;
  height: 2rpx;
  background: rgba(21, 32, 51, 0.25);
}

.action--disabled {
  opacity: 0.55;
  pointer-events: none;
}

.action--retry {
  margin-top: 40rpx;
}

.error-panel {
  width: 100%;
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.error-panel__text {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--ink-muted);
  line-height: 1.5;
  max-width: 560rpx;
}

.skeleton {
  background: var(--skeleton);
  border-radius: 6rpx;
}

.skeleton--price {
  width: 420rpx;
  height: 88rpx;
}

.skeleton-row {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.skeleton--chg {
  width: 140rpx;
  height: 36rpx;
}

.loading-hint {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--ink-subtle);
}

/* Loading：VIX 空弧骨架（§10） */
.vix-skeleton {
  width: 100%;
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.vix-skeleton__rule {
  width: 120rpx;
  height: 2rpx;
  margin-bottom: 36rpx;
  background: rgba(21, 32, 51, 0.12);
}

.vix-skeleton__arc {
  width: 420rpx;
  height: 210rpx;
  border: 20rpx solid var(--skeleton);
  border-bottom-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
  opacity: 0.85;
}

.skeleton--vix-value {
  margin-top: -40rpx;
  width: 120rpx;
  height: 40rpx;
}

.skeleton--vix-label {
  margin-top: 20rpx;
  width: 180rpx;
  height: 24rpx;
}

.vix-section {
  width: 100%;
  margin-top: 56rpx;
  padding-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.vix-section__rule {
  width: 120rpx;
  height: 2rpx;
  margin-bottom: 36rpx;
  background: rgba(21, 32, 51, 0.12);
}

.anim-in {
  animation: rise-in 280ms ease-out both;
}

.anim-in--delay1 {
  animation-delay: 60ms;
}

.anim-in--delay2 {
  animation-delay: 120ms;
}

.anim-in--delay3 {
  animation-delay: 180ms;
}

.anim-in--delay4 {
  animation-delay: 240ms;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes breath {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.96;
  }
}

@keyframes flash {
  0% {
    color: var(--up);
  }
  100% {
    color: var(--ink);
  }
}

@media (max-width: 320px) {
  .brand__title {
    font-size: 52rpx;
  }

  .hero__price {
    font-size: 96rpx;
  }
}
