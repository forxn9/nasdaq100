page {
  /* Binance market detail tokens */
  --bn-bg: #0b0e11;
  --bn-surface: #181a20;
  --bn-surface-2: #1e2026;
  --bn-border: #2b3139;
  --bn-text: #eaecef;
  --bn-text-secondary: #848e9c;
  --bn-text-tertiary: #5e6673;
  --bn-yellow: #f0b90b;
  --bn-up: #0ecb81;
  --bn-down: #f6465d;
  --bn-flat: #848e9c;
  --bn-skeleton: #2b3139;

  /* VIX zones kept semantic */
  --vix-low: #0ecb81;
  --vix-mid: #f0b90b;
  --vix-high: #f0b90b;
  --vix-extreme: #f6465d;

  /* aliases used by older class hooks */
  --up: var(--bn-up);
  --down: var(--bn-down);
  --flat: var(--bn-flat);
  --ink: var(--bn-text);
  --ink-muted: var(--bn-text-secondary);
  --ink-subtle: var(--bn-text-tertiary);
  --skeleton: var(--bn-skeleton);
  --warning: #f0b90b;

  min-height: 100vh;
  background: var(--bn-bg);
  color: var(--bn-text);
  font-family: "Binance Plex", "Noto Sans SC", "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

view,
text,
button {
  box-sizing: border-box;
}
