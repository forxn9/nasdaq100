<view class="chart {{ready ? 'chart--ready' : ''}}">
  <view class="chart__head">
    <text class="chart__range">{{rangeLabel}}</text>
    <text class="chart__chg chart__chg--{{direction}}">{{changePercentText}}</text>
  </view>
  <view class="chart__canvas-wrap">
    <canvas
      canvas-id="priceChart"
      class="chart__canvas"
      style="width: {{canvasW}}px; height: {{canvasH}}px;"
    ></canvas>
    <view wx:if="{{!points || !points.length}}" class="chart__empty">
      <text>暂无走势</text>
    </view>
  </view>
  <view class="chart__axis" wx:if="{{startLabel && endLabel}}">
    <text>{{startLabel}}</text>
    <text>{{endLabel}}</text>
  </view>
</view>
