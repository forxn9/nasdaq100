<view class="chart {{ready ? 'chart--ready' : ''}}">
  <!-- §13.3 图头：近十年 + 起止日期 · 涨跌额 · 涨跌幅 -->
  <view class="chart__head">
    <view class="chart__head-left">
      <text class="chart__range">{{rangeLabel}}</text>
      <text class="chart__dates" wx:if="{{dateRangeText}}">{{dateRangeText}}</text>
    </view>
    <view class="chart__chg chart__chg--{{direction}}">
      <text>{{changeText}}</text>
      <text class="chart__chg-gap"></text>
      <text>{{changePercentText}}</text>
    </view>
  </view>

  <view class="chart__canvas-wrap">
    <canvas
      canvas-id="priceChart"
      class="chart__canvas"
      style="width: {{canvasW}}px; height: {{canvasH}}px;"
    ></canvas>
    <view wx:if="{{!points || !points.length}}" class="chart__empty">
      <text>暂无走势</text>
    </view>
  </view>

  <view class="chart__axis" wx:if="{{startLabel && endLabel}}">
    <text>{{startLabel}}</text>
    <text>{{endLabel}}</text>
  </view>

  <!-- §13.2 底部双滑块 range scrubber：迷你 10Y + 窗外蒙暗 + 选中窗黄 tint -->
  <view
    class="chart__scrub {{dragging ? 'chart__scrub--active' : ''}}"
    wx:if="{{points && points.length > 1}}"
    catchtouchstart="onScrubStart"
    catchtouchmove="onScrubMove"
    catchtouchend="onScrubEnd"
    catchtouchcancel="onScrubEnd"
  >
    <canvas
      canvas-id="scrubChart"
      class="chart__scrub-canvas"
      style="width: {{scrubW}}px; height: {{scrubH}}px;"
    ></canvas>
    <view class="chart__scrub-mask chart__scrub-mask--left" style="width: {{maskLeftW}}px;"></view>
    <view class="chart__scrub-mask chart__scrub-mask--right" style="left: {{maskRightL}}px; width: {{maskRightW}}px;"></view>
    <view
      class="chart__scrub-window"
      style="left: {{windowLeft}}px; width: {{windowWidth}}px;"
    >
      <view class="chart__scrub-handle chart__scrub-handle--start">
        <view class="chart__scrub-handle-bar"></view>
      </view>
      <view class="chart__scrub-handle chart__scrub-handle--end">
        <view class="chart__scrub-handle-bar"></view>
      </view>
    </view>
  </view>

  <view class="chart__scrub-meta" wx:if="{{points && points.length > 1}}">
    <text class="chart__scrub-year">{{fullStartYear}}</text>
    <text
      class="chart__scrub-hint {{isFullWindow ? '' : 'chart__scrub-hint--action'}}"
      catchtap="onResetRange"
    >{{isFullWindow ? '拖动双柄选区间' : '复位'}}</text>
    <text class="chart__scrub-year">{{fullEndYear}}</text>
  </view>
</view>
