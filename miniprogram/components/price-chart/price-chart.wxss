.chart {
  width: 100%;
  opacity: 0;
  transition: opacity 280ms ease-out;
}

.chart--ready {
  opacity: 1;
}

.chart__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.chart__range {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-muted, #848e9c);
  letter-spacing: 0.04em;
}

.chart__chg {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
}

.chart__chg-sep {
  width: 0;
}

.chart__chg--up {
  color: var(--up, #f6465d);
}

.chart__chg--down {
  color: var(--down, #0ecb81);
}

.chart__chg--flat {
  color: var(--flat, #848e9c);
}

.chart__canvas-wrap {
  position: relative;
  width: 100%;
  min-height: 280rpx;
  display: flex;
  justify-content: center;
}

.chart__canvas {
  display: block;
}

.chart__empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-subtle, #5e6673);
  font-size: 24rpx;
}

.chart__axis {
  margin-top: 8rpx;
  padding: 0 4rpx;
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--ink-subtle, #5e6673);
  font-variant-numeric: tabular-nums;
}

.chart__scrub {
  position: relative;
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  background: var(--bg-elevated, #12161c);
  border-radius: 4rpx;
  overflow: hidden;
  touch-action: none;
}

.chart__scrub--active {
  outline: 1rpx solid rgba(255, 255, 255, 0.08);
}

.chart__scrub-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.chart__scrub-window {
  position: absolute;
  top: 0;
  bottom: 0;
  pointer-events: none;
  border-left: 2rpx solid rgba(234, 236, 239, 0.9);
  border-right: 2rpx solid rgba(234, 236, 239, 0.9);
  box-sizing: border-box;
}

.chart__scrub-handle {
  position: absolute;
  top: 50%;
  width: 10rpx;
  height: 36rpx;
  margin-top: -18rpx;
  border-radius: 2rpx;
  background: #eaecef;
  box-shadow: 0 0 0 4rpx rgba(11, 14, 17, 0.35);
}

.chart__scrub-handle--start {
  left: -5rpx;
}

.chart__scrub-handle--end {
  right: -5rpx;
}

.chart__scrub-hint {
  display: block;
  margin-top: 10rpx;
  padding: 0 4rpx;
  font-size: 20rpx;
  color: var(--ink-subtle, #5e6673);
}
