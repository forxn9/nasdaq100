.chart {
  width: 100%;
  opacity: 0;
  transition: opacity 280ms ease-out;
}

.chart--ready {
  opacity: 1;
}

.chart__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.chart__range {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--bn-text-secondary, #848e9c);
  letter-spacing: 0.04em;
}

.chart__chg {
  font-size: 24rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
}

.chart__chg--up {
  color: var(--bn-up, #0ecb81);
}

.chart__chg--down {
  color: var(--bn-down, #f6465d);
}

.chart__chg--flat {
  color: var(--bn-text-secondary, #848e9c);
}

.chart__canvas-wrap {
  position: relative;
  width: 100%;
  min-height: 280rpx;
  display: flex;
  justify-content: center;
}

.chart__canvas {
  display: block;
}

.chart__empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bn-text-tertiary, #5e6673);
  font-size: 24rpx;
}

.chart__axis {
  margin-top: 8rpx;
  padding: 0 4rpx;
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--bn-text-tertiary, #5e6673);
  font-variant-numeric: tabular-nums;
}
