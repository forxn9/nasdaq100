.chart {
  width: 100%;
  opacity: 0;
  transition: opacity 280ms ease-out;
}

.chart--ready {
  opacity: 1;
}

.chart__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.chart__head-left {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.chart__range {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-muted, #848e9c);
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

.chart__dates {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-subtle, #5e6673);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.chart__chg {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
}

.chart__chg-gap {
  width: 16rpx;
}

.chart__chg--up {
  color: var(--up, #f6465d);
}

.chart__chg--down {
  color: var(--down, #0ecb81);
}

.chart__chg--flat {
  color: var(--flat, #848e9c);
}

.chart__canvas-wrap {
  position: relative;
  width: 100%;
  min-height: 320rpx;
  display: flex;
  justify-content: center;
  background: var(--bg-elevated, #12161c);
  border-radius: 4rpx;
  overflow: hidden;
}

.chart__canvas {
  display: block;
}

.chart__empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-subtle, #5e6673);
  font-size: 24rpx;
}

.chart__axis {
  margin-top: 8rpx;
  padding: 0 4rpx;
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--ink-subtle, #5e6673);
  font-variant-numeric: tabular-nums;
}

/* §13.2 scrubber */
.chart__scrub {
  position: relative;
  margin-top: 16rpx;
  width: 100%;
  height: 72rpx; /* ~36px */
  background: var(--scrubber-track, #1e2329);
  border-radius: 4rpx;
  overflow: hidden;
}

.chart__scrub--active {
  outline: 1rpx solid rgba(255, 255, 255, 0.06);
}

.chart__scrub-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.chart__scrub-mask {
  position: absolute;
  top: 0;
  bottom: 0;
  background: var(--scrubber-mask, rgba(11, 14, 17, 0.72));
  pointer-events: none;
}

.chart__scrub-mask--left {
  left: 0;
}

.chart__scrub-mask--right {
  /* left/width via inline */
}

.chart__scrub-window {
  position: absolute;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background: var(--scrubber-window, rgba(240, 185, 11, 0.18));
  box-shadow: inset 0 0 0 1rpx rgba(240, 185, 11, 0.35);
  box-sizing: border-box;
}

/* 外扩命中区 ≥ 44×44pt；可视柄 4×22–28px */
.chart__scrub-handle {
  position: absolute;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  margin-top: -44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.chart__scrub-handle-bar {
  width: 8rpx; /* 4px */
  height: 56rpx; /* 28px */
  border-radius: 3rpx;
  background: var(--scrubber-handle, #eaecef);
}

.chart__scrub-handle--start {
  left: -44rpx;
}

.chart__scrub-handle--end {
  right: -44rpx;
}

.chart__scrub-meta {
  margin-top: 10rpx;
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18rpx;
  color: var(--ink-subtle, #5e6673);
}

.chart__scrub-year {
  font-variant-numeric: tabular-nums;
  min-width: 64rpx;
}

.chart__scrub-year:last-child {
  text-align: right;
}

.chart__scrub-hint {
  flex: 1;
  text-align: center;
  font-size: 18rpx;
  color: var(--ink-subtle, #5e6673);
}

.chart__scrub-hint--action {
  color: var(--ink-muted, #848e9c);
}
