.gauge {
  width: 100%;
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity 280ms ease-out, transform 280ms ease-out;
}

.gauge--ready {
  opacity: 1;
  transform: translateY(0);
}

.gauge__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.gauge__kicker {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--bn-yellow, #f0b90b);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 6rpx;
}

.gauge__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--bn-text, #eaecef);
  line-height: 1.3;
}

.gauge__symbol {
  font-size: 22rpx;
  color: var(--bn-text-secondary, #848e9c);
  font-variant-numeric: tabular-nums;
  margin-top: 4rpx;
}

.gauge__body {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.gauge__dial {
  position: relative;
  flex: 1.15;
  min-width: 0;
  display: flex;
  justify-content: center;
}

.gauge__canvas {
  display: block;
}

.gauge__readout {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 22%;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.gauge__value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--bn-text, #eaecef);
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
}

.gauge--empty .gauge__value {
  color: var(--bn-text-tertiary, #5e6673);
}

.gauge__meta {
  flex: 0.95;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-left: 8rpx;
}

.gauge__zone {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.3;
}

.gauge__delta {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Menlo", "Courier New", monospace;
}

.gauge__delta--up {
  color: var(--bn-up, #0ecb81);
}

.gauge__delta--down {
  color: var(--bn-down, #f6465d);
}

.gauge__delta--flat {
  color: var(--bn-text-secondary, #848e9c);
}

.gauge__delta-sep {
  color: var(--bn-text-tertiary, #5e6673);
  font-weight: 400;
}

.gauge__legend {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.gauge__legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.gauge__legend-swatch {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  flex-shrink: 0;
}

.gauge__legend-text {
  font-size: 20rpx;
  color: var(--bn-text-secondary, #848e9c);
  line-height: 1.2;
}

.gauge__hint {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--bn-text-tertiary, #5e6673);
  line-height: 1.4;
}
